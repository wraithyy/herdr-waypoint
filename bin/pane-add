#!/usr/bin/env bash
# Pane `waypoint.add-pane`: prompts for a name (pre-filled with the folder's
# own name — editable, not forced) and saves cwd -> name.
set -uo pipefail
ROOT="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=lib.sh
. "$ROOT/bin/lib.sh"

dir="${WP_CWD:-$PWD}"
default_name="$(basename "$dir")"

printf '\033[1;38;5;212mAdd waypoint\033[0m\n\n  %s\n\n' "$dir"
name=""
if [ -t 0 ]; then
  read -r -e -i "$default_name" -p "  name: " name || true
fi
name="${name:-$default_name}"

wp_add "$name" "$dir"
printf '\n  saved: %s -> %s\n' "$name" "$dir"
sleep 1
