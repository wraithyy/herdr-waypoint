#!/usr/bin/env bash
# Helper for pane-pick's fzf ctrl-r binding: $1 is the raw "name<TAB>path"
# line fzf handed back for the highlighted entry; prompt for a new name.
# Runs via fzf's execute() (not execute-silent), so it gets a real terminal.
set -uo pipefail
ROOT="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=lib.sh
. "$ROOT/bin/lib.sh"

line="${1:-}"
[ -n "$line" ] || exit 0
old_name="${line%%$'\t'*}"
path="${line#*$'\t'}"

printf '\n  rename \033[2m%s\033[0m\n\n' "$path"
new_name=""
read -r -p "  name [$old_name]: " new_name || true
wp_add "${new_name:-$old_name}" "$path"
