#!/usr/bin/env bash
# Pane `waypoint.pick-pane`: picks a saved waypoint, then opens it as a new
# workspace. Uses fzf when available (preview + ctrl-x delete + ctrl-r
# rename); falls back to a pure-bash chooser with the same controls
# (d delete, r rename) when fzf isn't installed.
set -uo pipefail
ROOT="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=lib.sh
. "$ROOT/bin/lib.sh"

herdr_bin="${HERDR_BIN_PATH:-herdr}"

die() {
  printf '%s\n' "$*"
  sleep 2
  exit 1
}

store="$(wp_store)"
[ -s "$store" ] || die "waypoint: no waypoints yet — run 'Waypoint: save current folder' first."

if command -v fzf >/dev/null 2>&1; then
  choice="$(fzf --delimiter=$'\t' --with-nth=1,2 --prompt='waypoint ▸ ' \
    --header='enter open · ctrl-x delete · ctrl-r rename · esc cancel' --reverse --no-multi \
    --preview '(cd {2} 2>/dev/null && git -c color.ui=always status -sb 2>/dev/null) || ls -la {2} 2>/dev/null' \
    --preview-window=right:50% \
    --bind "ctrl-x:execute-silent($ROOT/bin/wp-rm {})+reload(cat $store)" \
    --bind "ctrl-r:execute($ROOT/bin/wp-rename {})+reload(cat $store)" \
    < "$store")" || true
else
  choice="$("$ROOT/bin/pick-fallback")" || true
fi
[ -n "$choice" ] || exit 0

name="${choice%%$'\t'*}"
path="${choice#*$'\t'}"

[ -d "$path" ] || die "waypoint: '$path' no longer exists."

"$herdr_bin" workspace create --cwd "$path" --label "$name" --focus >/dev/null
