#!/usr/bin/env bash
# Pane `waypoint.pick-pane`: fzf over saved waypoints, then opens the chosen
# one as a new workspace. ctrl-x on the highlighted entry deletes it in place.
set -uo pipefail
ROOT="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=lib.sh
. "$ROOT/bin/lib.sh"

herdr_bin="${HERDR_BIN_PATH:-herdr}"

die() {
  printf '%s\n' "$*"
  sleep 2
  exit 1
}

command -v fzf >/dev/null 2>&1 || die "waypoint: fzf is not installed or not on PATH."

store="$(wp_store)"
[ -s "$store" ] || die "waypoint: no waypoints yet — run 'Waypoint: save current folder' first."

choice="$(fzf --delimiter=$'\t' --with-nth=1,2 --prompt='waypoint ▸ ' \
  --header='enter open · ctrl-x delete · esc cancel' --reverse --no-multi \
  --bind "ctrl-x:execute-silent($ROOT/bin/wp-rm {})+reload(cat $store)" \
  < "$store")" || true
[ -n "$choice" ] || exit 0

name="${choice%%$'\t'*}"
path="${choice#*$'\t'}"

[ -d "$path" ] || die "waypoint: '$path' no longer exists."

"$herdr_bin" workspace create --cwd "$path" --label "$name" --focus >/dev/null
